# ===== Trading mode =====
TRADING_MODE=PAPER

# ===== Exchange =====
EXCHANGE=binance
API_KEY=
API_SECRET=

# ===== Telegram =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# ===== Symbol / timeframes =====
SYMBOL=BTC/USDT
TIMEFRAME_TREND=1h
TIMEFRAME_ENTRY=15m

# ===== Risk =====
INITIAL_RISK_PERCENT=0.005
MAX_RISK_PERCENT=0.01
DAILY_MAX_DRAWDOWN=0.03
EMERGENCY_DRAWDOWN=0.05
MAX_CONSECUTIVE_LOSSES=4
MAX_OPEN_POSITIONS=1
BREAK_EVEN_R=1.0
MIN_RR=2.0

# ===== Strategy parameters =====
EMA_FAST=50
EMA_SLOW=200
RSI_PERIOD=14
ATR_PERIOD=14
ADX_PERIOD=14
ATR_MIN_PERCENT=0.20
ATR_MAX_PERCENT=3.00
MAX_SPREAD_PERCENT=0.10
ADX_MIN=20.0
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70

# ===== Execution / safety =====
LIVE_TRADING_ENABLED=false
FEE_RATE=0.001
SLIPPAGE_BPS=2.0

# ===== Persistence =====
DATABASE_URL=sqlite:///./trading_bot.db
